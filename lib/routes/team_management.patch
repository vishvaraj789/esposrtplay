+            style: TextStyle(color: AppColors.danger, fontSize: 9.5, fontWeight: FontWeight.w800),
+          ),
+        )
+            : Icon(Icons.chevron_right, color: AppColors.textSecondary),
+      ),
+    );
+  }
+}
