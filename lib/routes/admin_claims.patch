+++ eposrtplay/lib/core/utils/admin_claim.dart	2026-10-04 07:33:55.090302349 +0000
@@ -0,0 +1,17 @@
+import 'package:firebase_auth/firebase_auth.dart';
+
+import '../constants/admin_config.dart';
+
+/// True if [user]'s ID token carries the admin custom claim.
+///
+/// Reads the cached token by default (no network). Pass [forceRefresh] right
+/// after a claim has been granted/revoked to pull a fresh token. Fails closed:
+/// any error is treated as "not admin".
+Future<bool> userHasAdminClaim(User user, {bool forceRefresh = false}) async {
+  try {
+    final result = await user.getIdTokenResult(forceRefresh);
+    return result.claims?[kAdminClaim] == true;
+  } catch (_) {
+    return false;
+  }
+}
